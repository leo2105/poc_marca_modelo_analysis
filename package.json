{
  "name": "sneaker-validation-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "CHOKIDAR_USEPOLLING=true vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "deploy": "/bin/bash ./scripts/deploy.sh",
    "deploy:app": "SKIP_INFRA=true ATTACH_EDGE=false /bin/bash ./scripts/deploy.sh",
    "deploy:edge": "/bin/bash ./scripts/attach-auth-edge.sh",
    "sync:imgs": "/bin/bash ./scripts/sync-imgs.sh",
    "invite:user": "/bin/bash ./scripts/invite-user.sh"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "lucide-react": "^0.468.0",
    "vite": "^6.0.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.18.2"
  }
}
